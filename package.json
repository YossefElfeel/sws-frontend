{
  "name": "sws-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SWS design-review prototype. Not the production stack — see PRODUCT.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tokens:build": "node tokens/build.mjs",
    "tokens:check": "node tokens/build.mjs --check",
    "a11y": "node tokens/a11y-gate.mjs",
    "gate": "npm run tokens:check && npm run a11y"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
