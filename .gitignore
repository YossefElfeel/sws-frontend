# Dependencies
node_modules/

# Build output
dist/
build/
.cache/

# ...except the generated design tokens. Committed on purpose: both consumers can use the file
# without running a build, and a token change shows up as a reviewable diff. `node
# tokens/build.mjs --check` fails if it drifts from tokens.json.
!tokens/dist/
!tokens/dist/tokens.css

# Environment / secrets — never commit WHMCS API credentials
.env
.env.*
!.env.example
*.pem
*.key

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local scratch
tmp/
scratch/

# Impeccable review evidence — regenerated by scripts/capture.mjs, not source
.impeccable/review/
.impeccable/questions/

# Prototype build output
dist-prototype/

.vercel
.env*
