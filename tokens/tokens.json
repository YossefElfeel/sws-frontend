{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "SWS design tokens. Three layers: primitive -> semantic -> component. Values transcribed from Design Playbook v1.1 section 3 and are PROPOSED, not approved (see decision C22). No component token may reference a primitive directly.",
  "primitive": {
    "$description": "Layer 1. Raw values. Never referenced by a component token.",
    "purple": {
      "50":  { "$type": "color", "$value": "#F4F0FA" },
      "100": { "$type": "color", "$value": "#E7DEF5" },
      "200": { "$type": "color", "$value": "#CFBDEB" },
      "300": { "$type": "color", "$value": "#A98BD9" },
      "400": { "$type": "color", "$value": "#8459C4" },
      "500": { "$type": "color", "$value": "#5B2E91" },
      "600": { "$type": "color", "$value": "#4A2578" },
      "700": { "$type": "color", "$value": "#3A1C5E" },
      "800": { "$type": "color", "$value": "#2A1444" },
      "900": { "$type": "color", "$value": "#1B0D2C" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F8F7FA" },
      "100": { "$type": "color", "$value": "#F1EFF5" },
      "200": { "$type": "color", "$value": "#E4E1EB" },
      "300": { "$type": "color", "$value": "#CBC6D6" },
      "400": { "$type": "color", "$value": "#A29BB2" },
      "500": { "$type": "color", "$value": "#7B7389" },
      "600": { "$type": "color", "$value": "#5C5568" },
      "700": { "$type": "color", "$value": "#423C4D" },
      "800": { "$type": "color", "$value": "#2A2633" },
      "850": { "$type": "color", "$value": "#201D28" },
      "900": { "$type": "color", "$value": "#16131C" },
      "950": { "$type": "color", "$value": "#0E0C12" }
    },
    "status": {
      "success":      { "$type": "color", "$value": "#1B6E3C" },
      "success-dark": { "$type": "color", "$value": "#4ADE80" },
      "danger":       { "$type": "color", "$value": "#B3261E" },
      "danger-dark":  { "$type": "color", "$value": "#F87171" },
      "warning":      { "$type": "color", "$value": "#8A5A00" },
      "warning-dark": { "$type": "color", "$value": "#FBBF24" },
      "info":         { "$type": "color", "$value": "#1A4F8A" },
      "info-dark":    { "$type": "color", "$value": "#60A5FA" }
    }
  },

  "semantic": {
    "$description": "Layer 2. Dark mode happens HERE and nowhere else. Each token carries a light and a dark value.",
    "light": {
      "surface-base":         { "$type": "color", "$value": "{primitive.neutral.50}",  "$description": "Page background" },
      "surface-raised":       { "$type": "color", "$value": "{primitive.neutral.0}",   "$description": "Cards and panels" },
      "surface-sunken":       { "$type": "color", "$value": "{primitive.neutral.100}", "$description": "Inputs, recessed areas" },
      "text-primary":         { "$type": "color", "$value": "{primitive.neutral.900}" },
      "text-secondary":       { "$type": "color", "$value": "{primitive.neutral.600}" },
      "text-on-action":       { "$type": "color", "$value": "{primitive.neutral.0}",   "$description": "Text on the primary button" },
      "border-subtle":        { "$type": "color", "$value": "{primitive.neutral.200}" },
      "border-strong":        { "$type": "color", "$value": "{primitive.neutral.500}", "$description": "Input borders. RAISED from neutral-300 on 2026-07-29: the Playbook value failed WCAG 2.2 SC 1.4.11 at 1.56:1 / 1.67:1 against a 3:1 requirement. Do not revert to match the Playbook table — see tokens/README.md and gaps/gap-register.md G10." },
      "action-primary":       { "$type": "color", "$value": "{primitive.purple.500}" },
      "action-primary-hover": { "$type": "color", "$value": "{primitive.purple.600}" },
      "action-subtle-bg":     { "$type": "color", "$value": "{primitive.purple.50}" },
      "focus-ring":           { "$type": "color", "$value": "{primitive.purple.400}",  "$description": "Mandatory on every interactive element" },
      "status-success":       { "$type": "color", "$value": "{primitive.status.success}" },
      "status-danger":        { "$type": "color", "$value": "{primitive.status.danger}" },
      "status-warning":       { "$type": "color", "$value": "{primitive.status.warning}" },
      "status-info":          { "$type": "color", "$value": "{primitive.status.info}" }
    },
    "dark": {
      "surface-base":         { "$type": "color", "$value": "{primitive.neutral.900}", "$description": "Never pure black" },
      "surface-raised":       { "$type": "color", "$value": "{primitive.neutral.850}", "$description": "Lighter than base — depth via light, not shadow" },
      "surface-sunken":       { "$type": "color", "$value": "{primitive.neutral.950}" },
      "text-primary":         { "$type": "color", "$value": "{primitive.neutral.50}",  "$description": "Not pure white — pure white fatigues the eye" },
      "text-secondary":       { "$type": "color", "$value": "{primitive.neutral.400}" },
      "text-on-action":       { "$type": "color", "$value": "{primitive.neutral.900}" },
      "border-subtle":        { "$type": "color", "$value": "{primitive.neutral.800}" },
      "border-strong":        { "$type": "color", "$value": "{primitive.neutral.500}", "$description": "Input borders. RAISED from neutral-700 on 2026-07-29: the Playbook value failed WCAG 2.2 SC 1.4.11 at 1.74:1 / 1.57:1 against a 3:1 requirement. neutral-500 serves both themes. Do not revert to match the Playbook table — see tokens/README.md and gaps/gap-register.md G10." },
      "action-primary":       { "$type": "color", "$value": "{primitive.purple.300}",  "$description": "Desaturated for dark surfaces" },
      "action-primary-hover": { "$type": "color", "$value": "{primitive.purple.200}" },
      "action-subtle-bg":     { "$type": "color", "$value": "{primitive.purple.800}" },
      "focus-ring":           { "$type": "color", "$value": "{primitive.purple.300}" },
      "status-success":       { "$type": "color", "$value": "{primitive.status.success-dark}" },
      "status-danger":        { "$type": "color", "$value": "{primitive.status.danger-dark}" },
      "status-warning":       { "$type": "color", "$value": "{primitive.status.warning-dark}" },
      "status-info":          { "$type": "color", "$value": "{primitive.status.info-dark}" }
    }
  },

  "component": {
    "$description": "Layer 3. References semantic tokens ONLY. A component token pointing at a primitive is a bug — it makes dark mode impossible.",
    "button": {
      "primary-bg":       { "$type": "color", "$value": "{semantic.action-primary}" },
      "primary-bg-hover": { "$type": "color", "$value": "{semantic.action-primary-hover}" },
      "primary-text":     { "$type": "color", "$value": "{semantic.text-on-action}" },
      "secondary-border": { "$type": "color", "$value": "{semantic.border-strong}" },
      "height-sm":        { "$type": "dimension", "$value": "32px", "$description": "Playbook 7.1 Button size sm. Below the 44px touch-target rule — see a11y gate." },
      "height-md":        { "$type": "dimension", "$value": "40px", "$description": "Playbook 7.1 Button size md (default). Below the 44px touch-target rule — see a11y gate." },
      "height-lg":        { "$type": "dimension", "$value": "48px", "$description": "Playbook 7.1 Button size lg. Playbook says use lg for primary actions on mobile — the gate shows why." },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "input": {
      "bg":               { "$type": "color", "$value": "{semantic.surface-sunken}" },
      "border":           { "$type": "color", "$value": "{semantic.border-strong}" },
      "border-focus":     { "$type": "color", "$value": "{semantic.focus-ring}" },
      "border-error":     { "$type": "color", "$value": "{semantic.status-danger}" },
      "placeholder":      { "$type": "color", "$value": "{semantic.text-secondary}" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "card": {
      "bg":     { "$type": "color", "$value": "{semantic.surface-raised}" },
      "border": { "$type": "color", "$value": "{semantic.border-subtle}" }
    },
    "table": {
      "header-bg": { "$type": "color", "$value": "{semantic.surface-sunken}" },
      "row-hover": { "$type": "color", "$value": "{semantic.action-subtle-bg}" },
      "border":    { "$type": "color", "$value": "{semantic.border-subtle}" }
    },
    "banner": {
      "danger-bg":     { "$type": "color", "$value": "{semantic.status-danger}", "$extensions": { "sws.alpha": 0.12 } },
      "danger-border": { "$type": "color", "$value": "{semantic.status-danger}", "$extensions": { "sws.alpha": 0.40 } },
      "danger-icon":   { "$type": "color", "$value": "{semantic.status-danger}" }
    }
  },

  "typography": {
    "$description": "Playbook section 6.1. Second size value is mobile. Arabic needs taller line-height than Latin: 1.7-1.9 where Latin uses 1.5, because of diacritics and below-baseline dots.",
    "scale": {
      "display":  { "size": 40,   "size-mobile": 32, "line-height": 1.35, "weight": 800, "use": "Homepage headline only" },
      "h1":       { "size": 32,   "size-mobile": 26, "line-height": 1.4,  "weight": 700, "use": "Page title" },
      "h2":       { "size": 24,   "size-mobile": 21, "line-height": 1.45, "weight": 700, "use": "Section title" },
      "h3":       { "size": 19,   "line-height": 1.5,  "weight": 600, "use": "Card title" },
      "body-lg":  { "size": 17,   "line-height": 1.8,  "weight": 400, "use": "Lede paragraph" },
      "body":     { "size": 15,   "line-height": 1.8,  "weight": 400, "use": "Default" },
      "body-sm":  { "size": 13.5, "line-height": 1.7,  "weight": 400, "use": "Tables, supporting text" },
      "caption":  { "size": 12,   "line-height": 1.6,  "weight": 400, "use": "Labels, footnotes" },
      "mono":     { "size": 13.5, "line-height": 1.6,  "weight": 400, "use": "Domain, IP, codes — always LTR" }
    },
    "rules": [
      "Never use a weight below 400 for Arabic — 300 renders Arabic near-illegible on standard displays.",
      "Do not copy a Latin type scale unchanged. Arabic line-height must be taller.",
      "German is the width-governing language, not English (+30% and often more). Test every button and column header with German before approving it."
    ]
  },

  "spacing": {
    "$description": "Base-4 scale. No value outside this scale.",
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96]
  },

  "breakpoints": {
    "$description": "Mobile-first. Most of the Egyptian and Gulf market arrives on a phone.",
    "mobile":  { "min": 360,  "max": 767,  "columns": 4,  "gutter": 16, "margin": 16 },
    "tablet":  { "min": 768,  "max": 1023, "columns": 8,  "gutter": 24, "margin": 24 },
    "laptop":  { "min": 1024, "max": 1439, "columns": 12, "gutter": 24, "margin": 32 },
    "wide":    { "min": 1440, "max": null, "columns": 12, "gutter": 32, "margin": "auto", "max-width": 1280 }
  },

  "accessibility": {
    "$description": "Playbook section 11. Stated target is WCAG 2.2 AA (decision I17, still open). NOTE: the Playbook's own rules mix AA and AAA requirements — touch-target-min-px 44 is SC 2.5.5 (AAA, the AA bar is 24) and focus-ring-width-px 2 is SC 2.4.13 (AAA, SC 2.4.7 AA sets no thickness). The gate labels each check with its real SC and level so the team knows what it is actually committing to.",
    "contrast-normal-text": 4.5,
    "contrast-large-text": 3.0,
    "contrast-non-text": 3.0,
    "large-text-min-px": 24,
    "touch-target-min-px": 44,
    "touch-target-aa-min-px": 24,
    "focus-ring-width-px": 2,
    "interactive-components": [
      "button", "input", "select", "checkbox", "radio", "switch",
      "link", "tab", "pagination-item", "file-uploader"
    ]
  }
}
