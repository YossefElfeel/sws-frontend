{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "SWS design tokens. Three layers: primitive -> semantic -> component. Values are taken from the live production site at sws.somion.ch (measured 2026-09-01): Rubik, indigo #4E4FEB, green #22C55E, near-black #020617, white ground, 8-24px radii. The brand look is pinned by the running product, so this file matches it rather than proposing an alternative. No component token may reference a primitive directly.",
  "primitive": {
    "$description": "Layer 1. Raw values, sampled from the production site. Never referenced by a component token, and never exported to CSS.",
    "indigo": {
      "$description": "The brand accent. 500 is the exact value measured on the production Login and Get Started buttons.",
      "50":  { "$type": "color", "$value": "#EEEEFE" },
      "100": { "$type": "color", "$value": "#DEDEFC" },
      "200": { "$type": "color", "$value": "#C2C2F9" },
      "300": { "$type": "color", "$value": "#9B9BF4" },
      "400": { "$type": "color", "$value": "#7273F0" },
      "500": { "$type": "color", "$value": "#4E4FEB" },
      "600": { "$type": "color", "$value": "#3B3CD4" },
      "700": { "$type": "color", "$value": "#2F30A8" },
      "800": { "$type": "color", "$value": "#252680" },
      "900": { "$type": "color", "$value": "#1B1C5C" }
    },
    "slate": {
      "$description": "Text and chrome. 950 is the production body colour; the mid steps are the greys measured around it.",
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F8F9FC" },
      "100": { "$type": "color", "$value": "#F1F3F9" },
      "200": { "$type": "color", "$value": "#E5E7EB" },
      "300": { "$type": "color", "$value": "#CBD1DC" },
      "400": { "$type": "color", "$value": "#9CA3AF" },
      "500": { "$type": "color", "$value": "#6B7280" },
      "600": { "$type": "color", "$value": "#4B5563" },
      "700": { "$type": "color", "$value": "#334155" },
      "800": { "$type": "color", "$value": "#1E293B" },
      "850": { "$type": "color", "$value": "#141C2E" },
      "900": { "$type": "color", "$value": "#0B1220" },
      "950": { "$type": "color", "$value": "#020617" }
    },
    "status": {
      "$description": "success is the production green, measured at 132 uses across the page.",
      "success":      { "$type": "color", "$value": "#146132" },
      "success-dark": { "$type": "color", "$value": "#4ADE80" },
      "danger":       { "$type": "color", "$value": "#B3181B" },
      "danger-dark":  { "$type": "color", "$value": "#F87171" },
      "warning":      { "$type": "color", "$value": "#8A4308" },
      "warning-dark": { "$type": "color", "$value": "#FBBF24" },
      "info":         { "$type": "color", "$value": "#1D4ED8" },
      "info-dark":    { "$type": "color", "$value": "#93C5FD" }
    }
  },

  "semantic": {
    "$description": "Layer 2. Dark mode happens HERE and nowhere else. Each token carries a light and a dark value; the build fails if one theme is missing a token the other declares.",
    "light": {
      "surface-page":         { "$type": "color", "$value": "{primitive.slate.50}",  "$description": "The page ground. Near-white with the faintest cool cast, matching production." },
      "surface-base":         { "$type": "color", "$value": "{primitive.slate.0}" },
      "surface-raised":       { "$type": "color", "$value": "{primitive.slate.0}",   "$description": "Cards. White on near-white, separated by shadow rather than by a border." },
      "surface-sunken":       { "$type": "color", "$value": "{primitive.slate.100}", "$description": "Inputs and recessed areas" },
      "text-primary":         { "$type": "color", "$value": "{primitive.slate.950}" },
      "text-secondary":       { "$type": "color", "$value": "{primitive.slate.600}" },
      "text-disabled":        { "$type": "color", "$value": "{primitive.slate.500}", "$description": "WCAG exempts disabled controls from 1.4.3. Held to the 3:1 non-text bar anyway as an internal rule: a control nobody can read is a control nobody can find." },
      "text-on-action":       { "$type": "color", "$value": "{primitive.slate.0}" },
      "border-subtle":        { "$type": "color", "$value": "{primitive.slate.200}" },
      "border-strong":        { "$type": "color", "$value": "{primitive.slate.500}", "$description": "Input borders. Held at a value that clears WCAG 2.2 SC 1.4.11 against both surfaces — see gaps/gap-register.md G10." },
      "border-disabled":      { "$type": "color", "$value": "{primitive.slate.300}" },
      "surface-disabled":     { "$type": "color", "$value": "{primitive.slate.100}" },
      "action-primary":       { "$type": "color", "$value": "{primitive.indigo.500}", "$description": "#4E4FEB, measured on the production primary button" },
      "action-primary-hover": { "$type": "color", "$value": "{primitive.indigo.600}" },
      "action-subtle-bg":     { "$type": "color", "$value": "{primitive.indigo.50}",  "$description": "Icon tiles and the announcement pill" },
      "action-quiet":         { "$type": "color", "$value": "{primitive.indigo.700}", "$description": "Indigo text that has to pass 4.5:1 on white" },
      "focus-ring":           { "$type": "color", "$value": "{primitive.indigo.600}" },
      "status-success":       { "$type": "color", "$value": "{primitive.status.success}" },
      "status-danger":        { "$type": "color", "$value": "{primitive.status.danger}" },
      "status-warning":       { "$type": "color", "$value": "{primitive.status.warning}" },
      "status-info":          { "$type": "color", "$value": "{primitive.status.info}" }
    },
    "dark": {
      "surface-page":         { "$type": "color", "$value": "{primitive.slate.950}" },
      "surface-base":         { "$type": "color", "$value": "{primitive.slate.900}" },
      "surface-raised":       { "$type": "color", "$value": "{primitive.slate.850}", "$description": "Lighter than base — depth via light, not shadow" },
      "surface-sunken":       { "$type": "color", "$value": "{primitive.slate.950}" },
      "text-primary":         { "$type": "color", "$value": "{primitive.slate.50}",  "$description": "Not pure white — pure white fatigues the eye" },
      "text-secondary":       { "$type": "color", "$value": "{primitive.slate.400}" },
      "text-disabled":        { "$type": "color", "$value": "{primitive.slate.500}" },
      "text-on-action":       { "$type": "color", "$value": "{primitive.slate.950}" },
      "border-subtle":        { "$type": "color", "$value": "{primitive.slate.800}" },
      "border-strong":        { "$type": "color", "$value": "{primitive.slate.500}" },
      "border-disabled":      { "$type": "color", "$value": "{primitive.slate.700}" },
      "surface-disabled":     { "$type": "color", "$value": "{primitive.slate.850}" },
      "action-primary":       { "$type": "color", "$value": "{primitive.indigo.300}", "$description": "Lifted for dark surfaces. indigo-400 measured 4.39:1 as link text on a dark card." },
      "action-primary-hover": { "$type": "color", "$value": "{primitive.indigo.200}" },
      "action-subtle-bg":     { "$type": "color", "$value": "{primitive.indigo.900}" },
      "action-quiet":         { "$type": "color", "$value": "{primitive.indigo.200}" },
      "focus-ring":           { "$type": "color", "$value": "{primitive.indigo.300}" },
      "status-success":       { "$type": "color", "$value": "{primitive.status.success-dark}" },
      "status-danger":        { "$type": "color", "$value": "{primitive.status.danger-dark}" },
      "status-warning":       { "$type": "color", "$value": "{primitive.status.warning-dark}" },
      "status-info":          { "$type": "color", "$value": "{primitive.status.info-dark}" }
    }
  },

  "component": {
    "$description": "Layer 3. References semantic tokens ONLY. A component token pointing at a primitive is a bug — it makes dark mode impossible.",
    "button": {
      "primary-bg":       { "$type": "color", "$value": "{semantic.action-primary}" },
      "primary-bg-hover": { "$type": "color", "$value": "{semantic.action-primary-hover}" },
      "primary-text":     { "$type": "color", "$value": "{semantic.text-on-action}" },
      "secondary-border": { "$type": "color", "$value": "{semantic.action-primary}" },
      "secondary-text":   { "$type": "color", "$value": "{semantic.action-quiet}" },
      "disabled-bg":      { "$type": "color", "$value": "{semantic.surface-disabled}" },
      "disabled-text":    { "$type": "color", "$value": "{semantic.text-disabled}" },
      "height-sm":        { "$type": "dimension", "$value": "36px", "$description": "Dense contexts only. Its 44px hit area is declared below and enforced by the gate — see ADR-0004." },
      "height-md":        { "$type": "dimension", "$value": "44px", "$description": "Default. Raised from the Playbook's 40px on 2026-07-29 — see ADR-0002. Do not revert." },
      "height-lg":        { "$type": "dimension", "$value": "52px", "$description": "Production measures its hero buttons at 48px; 52px keeps a readable step above the 44px default." },
      "hit-area":         { "$type": "dimension", "$value": "44px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "input": {
      "bg":               { "$type": "color", "$value": "{semantic.surface-raised}" },
      "border":           { "$type": "color", "$value": "{semantic.border-strong}" },
      "border-focus":     { "$type": "color", "$value": "{semantic.focus-ring}" },
      "border-error":     { "$type": "color", "$value": "{semantic.status-danger}" },
      "placeholder":      { "$type": "color", "$value": "{semantic.text-secondary}" },
      "disabled-bg":      { "$type": "color", "$value": "{semantic.surface-disabled}" },
      "disabled-border":  { "$type": "color", "$value": "{semantic.border-disabled}" },
      "disabled-text":    { "$type": "color", "$value": "{semantic.text-disabled}" },
      "height-md":        { "$type": "dimension", "$value": "48px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "select": {
      "bg":               { "$type": "color", "$value": "{semantic.surface-raised}" },
      "border":           { "$type": "color", "$value": "{semantic.border-strong}" },
      "disabled-text":    { "$type": "color", "$value": "{semantic.text-disabled}" },
      "height-md":        { "$type": "dimension", "$value": "48px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "checkbox": {
      "border":           { "$type": "color", "$value": "{semantic.border-strong}" },
      "checked-bg":       { "$type": "color", "$value": "{semantic.action-primary}" },
      "checked-mark":     { "$type": "color", "$value": "{semantic.text-on-action}" },
      "disabled-border":  { "$type": "color", "$value": "{semantic.border-disabled}" },
      "size":             { "$type": "dimension", "$value": "20px" },
      "hit-area":         { "$type": "dimension", "$value": "44px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "radio": {
      "border":           { "$type": "color", "$value": "{semantic.border-strong}" },
      "checked-bg":       { "$type": "color", "$value": "{semantic.action-primary}" },
      "disabled-border":  { "$type": "color", "$value": "{semantic.border-disabled}" },
      "size":             { "$type": "dimension", "$value": "20px" },
      "hit-area":         { "$type": "dimension", "$value": "44px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "switch": {
      "track-off":        { "$type": "color", "$value": "{semantic.border-strong}" },
      "track-on":         { "$type": "color", "$value": "{semantic.action-primary}" },
      "knob":             { "$type": "color", "$value": "{semantic.surface-raised}" },
      "disabled-track":   { "$type": "color", "$value": "{semantic.border-disabled}" },
      "height-md":        { "$type": "dimension", "$value": "24px" },
      "hit-area":         { "$type": "dimension", "$value": "44px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "link": {
      "text":             { "$type": "color", "$value": "{semantic.action-quiet}" },
      "text-hover":       { "$type": "color", "$value": "{semantic.action-primary}" },
      "visited":          { "$type": "color", "$value": "{semantic.action-quiet}" },
      "hit-area":         { "$type": "dimension", "$value": "44px", "$description": "Standalone links. Inline links inside a paragraph inherit the line box and are exempt per SC 2.5.8." },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "tab": {
      "text":             { "$type": "color", "$value": "{semantic.text-secondary}" },
      "text-active":      { "$type": "color", "$value": "{semantic.action-quiet}" },
      "rule-active":      { "$type": "color", "$value": "{semantic.action-primary}" },
      "disabled-text":    { "$type": "color", "$value": "{semantic.text-disabled}" },
      "height-md":        { "$type": "dimension", "$value": "44px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "pagination-item": {
      "text":             { "$type": "color", "$value": "{semantic.text-primary}" },
      "active-bg":        { "$type": "color", "$value": "{semantic.action-primary}" },
      "active-text":      { "$type": "color", "$value": "{semantic.text-on-action}" },
      "disabled-text":    { "$type": "color", "$value": "{semantic.text-disabled}" },
      "size":             { "$type": "dimension", "$value": "44px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "file-uploader": {
      "border":           { "$type": "color", "$value": "{semantic.border-strong}" },
      "bg":               { "$type": "color", "$value": "{semantic.surface-sunken}" },
      "disabled-text":    { "$type": "color", "$value": "{semantic.text-disabled}" },
      "height-md":        { "$type": "dimension", "$value": "48px" },
      "focus-ring-width": { "$type": "dimension", "$value": "2px" }
    },
    "card": {
      "bg":       { "$type": "color", "$value": "{semantic.surface-raised}" },
      "border":   { "$type": "color", "$value": "{semantic.border-subtle}" },
      "tile-bg":  { "$type": "color", "$value": "{semantic.action-subtle-bg}", "$description": "The lavender icon tile behind a card's pictogram, as on production" },
      "tile-ink": { "$type": "color", "$value": "{semantic.action-primary}" }
    },
    "table": {
      "header-bg": { "$type": "color", "$value": "{semantic.surface-sunken}" },
      "row-hover": { "$type": "color", "$value": "{semantic.surface-sunken}" },
      "border":    { "$type": "color", "$value": "{semantic.border-subtle}" }
    },
    "banner": {
      "$description": "All four severities. Only danger existed until 2026-09-01, so dist/tokens.css shipped one severity of four while the gate passed all eight checks — the one place a pass covered a real absence. Screen S-05 needs four.",
      "danger-bg":      { "$type": "color", "$value": "{semantic.status-danger}",  "$extensions": { "sws.alpha": 0.10 } },
      "danger-border":  { "$type": "color", "$value": "{semantic.status-danger}",  "$extensions": { "sws.alpha": 0.35 } },
      "danger-icon":    { "$type": "color", "$value": "{semantic.status-danger}" },
      "success-bg":     { "$type": "color", "$value": "{semantic.status-success}", "$extensions": { "sws.alpha": 0.10 } },
      "success-border": { "$type": "color", "$value": "{semantic.status-success}", "$extensions": { "sws.alpha": 0.35 } },
      "success-icon":   { "$type": "color", "$value": "{semantic.status-success}" },
      "warning-bg":     { "$type": "color", "$value": "{semantic.status-warning}", "$extensions": { "sws.alpha": 0.10 } },
      "warning-border": { "$type": "color", "$value": "{semantic.status-warning}", "$extensions": { "sws.alpha": 0.35 } },
      "warning-icon":   { "$type": "color", "$value": "{semantic.status-warning}" },
      "info-bg":        { "$type": "color", "$value": "{semantic.status-info}",    "$extensions": { "sws.alpha": 0.10 } },
      "info-border":    { "$type": "color", "$value": "{semantic.status-info}",    "$extensions": { "sws.alpha": 0.35 } },
      "info-icon":      { "$type": "color", "$value": "{semantic.status-info}" }
    }
  },

  "typography": {
    "$description": "Rubik is the production face, confirmed by computed style on sws.somion.ch. It carries Latin and Arabic in one family, which is why the Arabic and English pages hold the same texture instead of pairing two unrelated faces.",
    "families": {
      "latin":  { "$value": "Rubik", "$description": "Measured on the live site." },
      "arabic": { "$value": "Rubik", "$description": "Rubik ships a full Arabic set, so one family covers both scripts." },
      "stack":  { "$value": "Rubik", "fallback": "system-ui, -apple-system, sans-serif" }
    },
    "scale": {
      "hero":     { "size": 60,   "size-mobile": 36, "line-height": 1.12, "weight": 700, "use": "Homepage headline" },
      "display":  { "size": 40,   "size-mobile": 30, "line-height": 1.2,  "weight": 700, "use": "Page titles" },
      "h1":       { "size": 34,   "size-mobile": 27, "line-height": 1.25, "weight": 700, "use": "Matches the production h1" },
      "h2":       { "size": 30,   "size-mobile": 24, "line-height": 1.3,  "weight": 700, "use": "Section titles" },
      "h3":       { "size": 20,   "line-height": 1.4,  "weight": 600, "use": "Card titles" },
      "body-lg":  { "size": 18,   "line-height": 1.65, "weight": 400, "use": "Lede paragraph" },
      "body":     { "size": 16,   "line-height": 1.7,  "weight": 400, "use": "Default — production body size" },
      "body-sm":  { "size": 14,   "line-height": 1.6,  "weight": 400, "use": "Supporting text" },
      "caption":  { "size": 12.5, "line-height": 1.5,  "weight": 500, "use": "Labels and column heads" },
      "mono":     { "size": 14,   "line-height": 1.5,  "weight": 500, "use": "Serials, domains, IPs — always LTR" }
    },
    "rules": [
      "Never use a weight below 400 for Arabic — 300 renders Arabic near-illegible on standard displays.",
      "Arabic line-height runs taller than Latin at the same size because of diacritics and below-baseline dots.",
      "German is the width-governing language, not English (+30% and often more). Test every button and column header with German before approving it.",
      "All numerals are Latin (0123) in every context including Arabic UI — decision B4, 2026-09-01.",
      "Tabular figures are mandatory anywhere numbers stack in a column."
    ]
  },

  "radius": {
    "$description": "Measured on production: 4, 6, 8, 12, 16 and full pills all appear. This is the subset the system uses.",
    "none": { "$type": "dimension", "$value": "0px" },
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "xl":   { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },

  "rule": {
    "$description": "Hairline weights for tables and dividers.",
    "hair":  { "$type": "dimension", "$value": "1px" },
    "base":  { "$type": "dimension", "$value": "2px" },
    "heavy": { "$type": "dimension", "$value": "3px" }
  },

  "shadow": {
    "$description": "Offset plus soft blur, never a zero-offset halo. Alpha black is deliberate: a shadow is absence of light, not a palette colour.",
    "sm":   { "$value": "0 1px 2px rgba(2, 6, 23, 0.06)" },
    "card": { "$value": "0 4px 20px -4px rgba(2, 6, 23, 0.08), 0 1px 3px rgba(2, 6, 23, 0.04)" },
    "lift": { "$value": "0 14px 40px -12px rgba(2, 6, 23, 0.16), 0 2px 8px rgba(2, 6, 23, 0.05)" },
    "cta":  { "$value": "0 8px 24px -8px rgba(78, 79, 235, 0.55)" }
  },

  "motion": {
    "$description": "Exponential ease-out from an already-visible default. Every duration is overridden to 0 under prefers-reduced-motion.",
    "duration": {
      "fast": { "$type": "duration", "$value": "140ms" },
      "base": { "$type": "duration", "$value": "220ms" },
      "slow": { "$type": "duration", "$value": "340ms" },
      "tear": { "$type": "duration", "$value": "420ms", "$description": "Add-to-cart confirmation" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$description": "Expo-out" },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "stamp":    { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "spacing": {
    "$description": "Base-4 scale. No value outside this scale.",
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96]
  },

  "breakpoints": {
    "$description": "Mobile-first. Most of the Egyptian and Gulf market arrives on a phone.",
    "mobile":  { "min": 360,  "max": 767,  "columns": 4,  "gutter": 16, "margin": 16 },
    "tablet":  { "min": 768,  "max": 1023, "columns": 8,  "gutter": 24, "margin": 24 },
    "laptop":  { "min": 1024, "max": 1439, "columns": 12, "gutter": 24, "margin": 32 },
    "wide":    { "min": 1440, "max": null, "columns": 12, "gutter": 32, "margin": "auto", "max-width": 1280 }
  },

  "accessibility": {
    "$description": "Formal commitment is WCAG 2.2 AA (decision I17, resolved 2026-09-01). Two internal rules deliberately exceed AA and are held on purpose: touch-target-min-px 44 is SC 2.5.5 (AAA; the AA bar is 24) and focus-ring-width-px 2 is SC 2.4.13 (AAA; SC 2.4.7 sets no thickness). The gate labels each check with its real SC and level, so AA failures block and AAA shortfalls warn.",
    "contrast-normal-text": 4.5,
    "contrast-large-text": 3.0,
    "contrast-non-text": 3.0,
    "large-text-min-px": 24,
    "touch-target-min-px": 44,
    "touch-target-aa-min-px": 24,
    "focus-ring-width-px": 2,
    "interactive-components": [
      "button", "input", "select", "checkbox", "radio", "switch",
      "link", "tab", "pagination-item", "file-uploader"
    ]
  }
}
